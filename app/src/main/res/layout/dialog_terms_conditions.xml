<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms &amp; Conditions"
            android:textColor="#1E293B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseTerms"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#64748B" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:text="1. Acceptance of Terms" style="@style/TermsHeaderStyle" />
            <TextView
                android:text="By accessing and using MediLink, you accept and agree to be bound by the terms and provision of this agreement."
                style="@style/TermsBodyStyle" />

            <TextView android:text="2. Use of Service" style="@style/TermsHeaderStyle" />
            <TextView
                android:text="MediLink provides healthcare connectivity services. Users must provide accurate information and maintain confidentiality of their account."
                style="@style/TermsBodyStyle" />

            <TextView android:text="3. Privacy Policy" style="@style/TermsHeaderStyle" />
            <TextView
                android:text="Your privacy is important to us. All medical information is encrypted and stored securely in compliance with healthcare regulations."
                style="@style/TermsBodyStyle" />

            <TextView android:text="4. Medical Disclaimer" style="@style/TermsHeaderStyle" />
            <TextView
                android:text="MediLink is a platform connecting patients with healthcare professionals. It does not provide medical advice, diagnosis, or treatment."
                style="@style/TermsBodyStyle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/language_option_bg"
                android:padding="16dp"
                android:text="Last updated: January 2026"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>