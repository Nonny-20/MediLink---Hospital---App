<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_slate">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bookingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ml_slate_primary"
        android:paddingTop="48dp"
        android:paddingBottom="60dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right"
                app:tint="#FFFFFF" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Book Appointment"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bookingHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F0FDFA"
                app:strokeWidth="1dp"
                app:strokeColor="#CCFBF1">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <ImageView
                        android:id="@+id/iconAi"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/ml_teal_primary"/>
                    <TextView
                        android:id="@+id/txtHelpTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/iconAi"
                        android:layout_marginStart="12dp"
                        android:text="Need help selecting?"
                        android:textColor="#0F766E"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/txtHelpDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtHelpTitle"
                        android:layout_toEndOf="@id/iconAi"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:text="Our AI assistant can suggest a specialist based on your symptoms."
                        android:textColor="#134E4A"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/txtGetAI"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtHelpDesc"
                        android:layout_toEndOf="@id/iconAi"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="8dp"
                        android:text="Get AI Recommendation →"
                        android:textColor="@color/ml_teal_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="12dp"
                        android:paddingEnd="12dp"
                        android:minHeight="48dp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="16dp"
                android:text="Select Professional Type"
                android:textColor="@color/ml_slate_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardGP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/iconBg1"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardCornerRadius="26dp"
                        app:cardBackgroundColor="@color/bg_light_slate"
                        app:cardElevation="0dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_medical_services" app:tint="@color/ml_slate_primary"/>
                    </androidx.cardview.widget.CardView>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconBg1" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="General Practitioner" android:textColor="@color/ml_slate_dark" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="For common illnesses and checkups" android:textColor="@color/text_subtitle" android:textSize="13sp"/>
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardSpecialist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/iconBg2"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardCornerRadius="26dp"
                        app:cardBackgroundColor="@color/bg_light_slate"
                        app:cardElevation="0dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_history" app:tint="@color/ml_slate_primary"/>
                    </androidx.cardview.widget.CardView>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconBg2" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medical Specialist" android:textColor="@color/ml_slate_dark" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cardiology, Dermatology, etc." android:textColor="@color/text_subtitle" android:textSize="13sp"/>
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTherapist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/iconBg3"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardCornerRadius="26dp"
                        app:cardBackgroundColor="@color/bg_light_slate"
                        app:cardElevation="0dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_person" app:tint="@color/ml_slate_primary"/>
                    </androidx.cardview.widget.CardView>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconBg3" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mental Health Support" android:textColor="@color/ml_slate_dark" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Counselors and Psychologists" android:textColor="@color/text_subtitle" android:textSize="13sp"/>
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>