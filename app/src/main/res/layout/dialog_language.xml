<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="#CBD5E1" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Language"
            android:textColor="#1E293B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#64748B" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="300dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnEnglish"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/language_selected_bg"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="English"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAfrikaans"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/language_option_bg"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="Afrikaans"
                android:textColor="#1E293B"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnZulu"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/language_option_bg"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="isiZulu"
                android:textColor="#1E293B"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnXhosa"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/language_option_bg"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="isiXhosa"
                android:textColor="#1E293B"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnSotho"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/language_option_bg"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="Sesotho"
                android:textColor="#1E293B"
                android:textSize="16sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>