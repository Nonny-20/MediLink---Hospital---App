<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="#CBD5E1" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy &amp; Security"
            android:textColor="#1E293B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnClosePrivacyDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/btnChangePassword"
        style="@style/PrivacyRowStyle">
        <TextView android:text="Change Password" style="@style/PrivacyTitleStyle" />
        <TextView android:text="Update your login password" style="@style/PrivacySubtextStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnTwoFactor"
        style="@style/PrivacyRowStyle">
        <TextView android:text="Two-Factor Authentication" style="@style/PrivacyTitleStyle" />
        <TextView android:text="Add extra security layer" style="@style/PrivacySubtextStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnDataPrivacy"
        style="@style/PrivacyRowStyle">
        <TextView android:text="Data &amp; Privacy" style="@style/PrivacyTitleStyle" />
        <TextView android:text="Manage your information" style="@style/PrivacySubtextStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnDeleteAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/delete_account_bg"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:text="Delete Account"
            android:textColor="#EF4444"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:text="Permanently remove your data"
            android:textColor="#FCA5A5"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>