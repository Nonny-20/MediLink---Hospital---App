<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_slate"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="50dp"
        android:src="@drawable/medilink_logo_icon"
        android:contentDescription="MediLink Logo" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDI"
            android:textColor="@color/ml_slate_primary"
            android:textSize="34sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LINK"
            android:textColor="@color/ml_teal_accent"
            android:textSize="34sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connecting you to better care"
        android:textColor="@color/ml_slate_dark"
        android:textSize="18sp"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/ml_teal_accent"
        android:text="Login (Registered Users)"
        android:textAllCaps="false"
        android:textColor="@color/ml_slate_dark"
        android:textSize="17sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_login"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/ml_slate_dark"
        app:cornerRadius="16dp" />

    <Button
        android:id="@+id/btnSignUp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="Sign Up (New Users)"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textColor="@color/ml_slate_primary"
        app:icon="@drawable/ic_signup"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/ml_slate_primary"
        app:strokeColor="@color/ml_slate_primary"
        app:strokeWidth="2dp"
        app:cornerRadius="16dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E0F2F1"> <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to MediLink!"
            android:textColor="@color/ml_slate_dark"
            android:textStyle="bold"
            android:textSize="18sp"
            android:drawableStart="@drawable/ic_info"
            android:drawableTint="@color/ml_slate_primary"
            android:drawablePadding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Registered patients: Use your Patient ID/Email and password from the hospital to log in.\n\nNew users: Create an account to access our healthcare services."
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp" />
    </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>