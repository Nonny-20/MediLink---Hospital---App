<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms &amp; Conditions"
            android:textColor="@color/ml_slate_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseTerms"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/ml_slate_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:fadeScrollbars="false"
        android:scrollbarThumbVertical="@color/gray_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:text="1. Acceptance of Terms"
                android:textColor="@color/ml_teal_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <TextView
                android:text="By accessing and using MediLink, you accept and agree to be bound by the terms and provision of this agreement."
                android:textColor="@color/ml_slate_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:text="2. Use of Service"
                android:textColor="@color/ml_teal_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="MediLink provides healthcare connectivity services. Users must provide accurate information and maintain confidentiality of their account."
                android:textColor="@color/ml_slate_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:text="3. Privacy Policy"
                android:textColor="@color/ml_teal_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="Your privacy is important to us. All medical information is encrypted and stored securely in compliance with healthcare regulations."
                android:textColor="@color/ml_slate_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:text="4. Medical Disclaimer"
                android:textColor="@color/ml_teal_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="MediLink is a platform connecting patients with healthcare professionals. It does not provide medical advice, diagnosis, or treatment."
                android:textColor="@color/ml_slate_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8FAFC"
                android:padding="16dp"
                android:text="Last updated: February 2026"
                android:textColor="@color/text_subtitle"
                android:textAlignment="center"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>