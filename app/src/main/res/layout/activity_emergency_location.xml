<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F9FF"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvLocHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="Location Details"
        android:textColor="@color/ml_blue"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvLocSubHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Where should we send help? Please confirm the address."
        android:textColor="#475569"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLocHeader" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvLocSubHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btnDetectLocation"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/ml_blue"
                android:text="Use Current Location"
                android:drawableStart="@android:drawable/ic_menu_mylocation"
                android:paddingStart="16dp"
                android:textColor="@color/white"
                app:cornerRadius="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="— OR ENTER MANUALLY —"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etManualLocation"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/input_background"
                android:gravity="top"
                android:hint="Type house number, street name, or building details..."
                android:inputType="textPostalAddress|textMultiLine"
                android:padding="12dp"
                android:textSize="15sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnConfirmLocation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="@color/ml_navy"
        android:text="Confirm &amp; Send Alert"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>