<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MediLink" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1E40AF</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="NotificationRowStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/language_option_bg</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="NotificationTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:textColor">#1E293B</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="NotificationSwitchStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
    </style>

    <style name="PrivacyRowStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/language_option_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="PrivacyTitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#1E293B</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PrivacySubtextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#64748B</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TermsHeaderStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#1E293B</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="TermsBodyStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#475569</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>